<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>소크라테스 수학 선생님 - 도형의 넓이</title>
<style>
:root{--p:#2563eb;--pl:#eff6ff;--bg:#f8fafc;--fg:#111827;--bd:#d1d5db;--ok:#16a34a;--warn:#d97706;--r:10px;}
*{box-sizing:border-box}
body{margin:0;font-family:Pretendard,-apple-system,"Malgun Gothic","Apple SD Gothic Neo",sans-serif;background:var(--bg);color:var(--fg);height:100vh;display:flex;flex-direction:column}
header{background:#fff;border-bottom:1px solid var(--bd);padding:12px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
header h1{font-size:18px;margin:0}
header .sub{font-size:13px;color:#6b7280}
.score{font-size:14px;color:#374151}
.score b{color:var(--p)}
.wrap{flex:1;display:flex;min-height:0}
aside{width:250px;background:#fff;border-right:1px solid var(--bd);padding:14px;overflow-y:auto;flex-shrink:0}
aside h2{font-size:13px;color:#6b7280;margin:14px 0 8px;font-weight:600}
aside h2:first-child{margin-top:0}
.topic{display:flex;justify-content:space-between;align-items:center;width:100%;text-align:left;border:1px solid var(--bd);background:#fff;border-radius:8px;padding:9px 10px;margin-bottom:6px;cursor:pointer;font-size:14px;font-family:inherit;color:var(--fg)}
.topic:hover{border-color:var(--p)}
.topic.active{border-color:var(--p);background:var(--pl);font-weight:600}
.topic .st{font-size:12px;color:#9ca3af}
.topic .st.done{color:var(--ok);font-weight:600}
.note{font-size:13px;line-height:1.6;border:1px solid var(--bd);border-radius:8px;padding:8px 10px;min-height:60px;background:#fffbeb}
.note div{border-bottom:1px dashed #e5e7eb;padding:3px 0}
.note div:last-child{border-bottom:none}
.note .empty{color:#9ca3af}
main{flex:1;display:flex;flex-direction:column;min-width:0}
#chat{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:12px}
.msg{max-width:min(620px,85%);padding:11px 14px;border-radius:14px;line-height:1.6;font-size:15px;white-space:pre-wrap;word-break:keep-all}
.bot{align-self:flex-start;background:#fff;border:1px solid var(--bd);border-top-left-radius:4px}
.user{align-self:flex-end;background:var(--p);color:#fff;border-top-right-radius:4px}
.bot .who{font-size:12px;color:var(--p);font-weight:700;margin-bottom:3px}
.bot.hint{background:#fff7ed;border-color:#fed7aa}
.bot.hint .who{color:var(--warn)}
.bot.good{background:#f0fdf4;border-color:#bbf7d0}
.bot.good .who{color:var(--ok)}
.bot svg{display:block;width:100%;max-width:340px;margin-top:8px;background:#fafafa;border:1px solid #e5e7eb;border-radius:8px}
.choices{display:flex;flex-wrap:wrap;gap:8px;align-self:flex-start}
.choices button{border:1px solid var(--p);background:#fff;color:var(--p);border-radius:8px;padding:8px 14px;font-size:14px;cursor:pointer;font-family:inherit}
.choices button:hover{background:var(--pl)}
.typing{align-self:flex-start;color:#9ca3af;font-size:13px;padding-left:6px}
.bar{border-top:1px solid var(--bd);background:#fff;padding:10px 14px;display:flex;gap:8px;flex-wrap:wrap}
.bar input{flex:1;min-width:180px;border:1px solid var(--bd);border-radius:8px;padding:11px 12px;font-size:15px;font-family:inherit}
.bar input:focus{outline:2px solid var(--p);border-color:transparent}
.bar button{border:none;border-radius:8px;padding:0 16px;font-size:14px;cursor:pointer;font-family:inherit}
#send{background:var(--p);color:#fff}
.ghost{background:#f3f4f6;color:#374151}
.progress{height:4px;background:#e5e7eb}
.progress div{height:100%;background:var(--p);width:0;transition:width .3s}
@media(max-width:760px){aside{display:none}aside.open{display:block;position:fixed;top:60px;left:0;bottom:0;z-index:5}#menu{display:inline-block!important}}
#menu{display:none;border:1px solid var(--bd);background:#fff;border-radius:8px;padding:6px 10px;cursor:pointer}
</style>
</head>
<body>
<header>
  <div>
    <h1>소크라테스 수학 선생님 · 도형의 넓이</h1>
    <div class="sub">정답을 알려주기보다 질문으로 스스로 찾도록 도와줘요 (초등 5~6학년)</div>
  </div>
  <div style="display:flex;gap:10px;align-items:center">
    <span class="score">혼자 맞힘 <b id="sc1">0</b> · 힌트 받고 맞힘 <b id="sc2">0</b></span>
    <button id="menu" onclick="document.querySelector('aside').classList.toggle('open')">단원</button>
  </div>
</header>
<div class="progress"><div id="pg"></div></div>
<div class="wrap">
  <aside>
    <h2>탐구할 도형</h2>
    <div id="topics"></div>
    <h2>나의 발견 노트</h2>
    <div class="note" id="note"><span class="empty">스스로 발견한 공식이 여기에 쌓여요.</span></div>
    <h2>이렇게 말해도 돼요</h2>
    <div style="font-size:13px;color:#4b5563;line-height:1.7">"모르겠어요" · "힌트" → 실마리 질문<br>"처음부터" → 이 단원 다시 하기</div>
  </aside>
  <main>
    <div id="chat"></div>
    <div class="bar">
      <input id="inp" placeholder="생각한 답이나 이유를 적어 보세요" autocomplete="off">
      <button class="ghost" onclick="userSay('모르겠어요')">모르겠어요</button>
      <button id="send">보내기</button>
    </div>
  </main>
</div>
<script>
// ---------- 그림 ----------
var S = {
  para: '<svg viewBox="0 0 320 160"><polygon points="40,130 220,130 270,40 90,40" fill="#dbeafe" stroke="#2563eb" stroke-width="2"/><line x1="90" y1="40" x2="90" y2="130" stroke="#dc2626" stroke-dasharray="5 4" stroke-width="2"/><rect x="90" y="120" width="10" height="10" fill="none" stroke="#dc2626"/><text x="120" y="150" font-size="13">밑변 6cm</text><text x="96" y="90" font-size="13" fill="#dc2626">높이 4cm</text><text x="232" y="85" font-size="12" fill="#6b7280">5cm</text></svg>',
  paraCut: '<svg viewBox="0 0 320 160"><polygon points="90,130 220,130 270,40 90,40" fill="#dbeafe" stroke="#2563eb" stroke-width="2"/><polygon points="40,130 90,130 90,40" fill="#fde68a" stroke="#d97706" stroke-width="2"/><polygon points="220,130 270,130 270,40" fill="none" stroke="#d97706" stroke-dasharray="5 4" stroke-width="2"/><path d="M65 105 Q160 160 245 110" fill="none" stroke="#d97706" stroke-width="1.5" marker-end="url(#a)"/><defs><marker id="a" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8z" fill="#d97706"/></marker></defs><text x="110" y="25" font-size="13">노란 삼각형을 잘라 오른쪽으로 옮기면?</text></svg>',
  tri: '<svg viewBox="0 0 320 160"><polygon points="40,130 200,130 100,40" fill="#dbeafe" stroke="#2563eb" stroke-width="2"/><polygon points="200,130 100,40 260,40" fill="#fde68a" fill-opacity=".6" stroke="#d97706" stroke-dasharray="5 4" stroke-width="2"/><line x1="100" y1="40" x2="100" y2="130" stroke="#dc2626" stroke-dasharray="4 4"/><text x="95" y="150" font-size="13">밑변</text><text x="104" y="95" font-size="12" fill="#dc2626">높이</text><text x="190" y="28" font-size="12" fill="#d97706">똑같은 삼각형을 돌려 붙임</text></svg>',
