  rhom: '<svg viewBox="0 0 320 160"><rect x="60" y="25" width="200" height="110" fill="none" stroke="#9ca3af" stroke-dasharray="5 4" stroke-width="2"/><polygon points="160,25 260,80 160,135 60,80" fill="#dbeafe" stroke="#2563eb" stroke-width="2"/><line x1="60" y1="80" x2="260" y2="80" stroke="#dc2626" stroke-width="1.5"/><line x1="160" y1="25" x2="160" y2="135" stroke="#dc2626" stroke-width="1.5"/><text x="200" y="74" font-size="12" fill="#dc2626">대각선 8cm</text><text x="165" y="115" font-size="12" fill="#dc2626">대각선 6cm</text></svg>',
  circ: '<svg viewBox="0 0 320 160"><circle cx="75" cy="80" r="55" fill="#dbeafe" stroke="#2563eb" stroke-width="2"/><g stroke="#2563eb" stroke-width="1"><line x1="20" y1="80" x2="130" y2="80"/><line x1="75" y1="25" x2="75" y2="135"/><line x1="36" y1="41" x2="114" y2="119"/><line x1="114" y1="41" x2="36" y2="119"/></g><text x="140" y="85" font-size="20">→</text><path d="M170 120 L182 50 L194 120 L206 50 L218 120 L230 50 L242 120 L254 50 L266 120 L278 50 L290 120" fill="#dbeafe" stroke="#2563eb" stroke-width="1.5"/><text x="180" y="145" font-size="12">아주 잘게 잘라 번갈아 붙이면?</text></svg>',
  circRect: '<svg viewBox="0 0 320 160"><rect x="60" y="40" width="200" height="70" fill="#dbeafe" stroke="#2563eb" stroke-width="2"/><text x="100" y="32" font-size="12">가로 = 원주의 ( ? )</text><text x="266" y="80" font-size="12" fill="#dc2626">세로</text><text x="266" y="96" font-size="12" fill="#dc2626">= ( ? )</text><text x="80" y="130" font-size="12" fill="#6b7280">위쪽 + 아래쪽 = 원의 둘레 전체</text></svg>',
  box: '<svg viewBox="0 0 320 160"><polygon points="90,60 210,60 250,30 130,30" fill="#bfdbfe" stroke="#2563eb" stroke-width="2"/><polygon points="90,60 210,60 210,130 90,130" fill="#dbeafe" stroke="#2563eb" stroke-width="2"/><polygon points="210,60 250,30 250,100 210,130" fill="#93c5fd" stroke="#2563eb" stroke-width="2"/><text x="135" y="148" font-size="12">가로 4cm</text><text x="236" y="125" font-size="12">세로 3cm</text><text x="40" y="100" font-size="12">높이 2cm</text></svg>'
