// ---------- 상태 ----------
var st = {t:null, s:0, tries:0, done:{}, solo:0, helped:0, lock:false};
var chat = document.getElementById('chat');
var inp = document.getElementById('inp');
var PRAISE = ['좋아요!','훌륭해요!','바로 그거예요!','멋진 생각이에요!','맞아요!'];
var RETRY = ['음, 다시 한번 생각해 볼까요?','좋은 시도예요. 그런데 이렇게 생각해 보면 어떨까요?','거의 다 왔어요. 질문 하나 더 할게요.'];
function pick(a){return a[Math.floor(Math.random()*a.length)];}

function addMsg(text, cls, svgKey){
  var d = document.createElement('div');
  d.className = 'msg ' + cls;
  if (cls.indexOf('bot') === 0) {
    var w = document.createElement('div');
    w.className = 'who';
    w.textContent = cls.indexOf('hint') > 0 ? '실마리 질문' : (cls.indexOf('good') > 0 ? '선생님' : '소크라테스 선생님');
    d.appendChild(w);
  }
  var t = document.createElement('div');
  t.textContent = text;
  d.appendChild(t);
  if (svgKey && S[svgKey]) {
    var sv = document.createElement('div');
    sv.innerHTML = S[svgKey];
    d.appendChild(sv);
  }
  chat.appendChild(d);
  chat.scrollTop = chat.scrollHeight;
}
function bot(text, cls, svgKey, cb){
  st.lock = true;
  var ty = document.createElement('div');
  ty.className = 'typing';
  ty.textContent = '선생님이 생각하는 중...';
  chat.appendChild(ty);
  chat.scrollTop = chat.scrollHeight;
  setTimeout(function(){
    ty.remove();
    addMsg(text, 'bot ' + (cls || ''), svgKey);
    st.lock = false;
    if (cb) cb();
  }, 450);
}
function clearChoices(){
  var c = document.querySelectorAll('.choices');
  for (var i = 0; i < c.length; i++) c[i].remove();
}
function showChoices(list){
  clearChoices();
  var box = document.createElement('div');
  box.className = 'choices';
  list.forEach(function(c){
    var b = document.createElement('button');
    b.textContent = c;
    b.onclick = function(){ userSay(c); };
    box.appendChild(b);
  });
  chat.appendChild(box);
  chat.scrollTop = chat.scrollHeight;
}

function renderTopics(){
  var el = document.getElementById('topics');
  el.innerHTML = '';
  TOPICS.forEach(function(t){
    var b = document.createElement('button');
    b.className = 'topic' + (st.t === t ? ' active' : '');
    var stt = st.done[t.id] ? '<span class="st done">완료</span>' : (st.t === t ? '<span class="st">' + (st.s + 1) + '/' + t.steps.length + '</span>' : '<span class="st">' + t.steps.length + '문항</span>');
    b.innerHTML = '<span>' + t.name + '</span>' + stt;
    b.onclick = function(){ startTopic(t); document.querySelector('aside').classList.remove('open'); };
    el.appendChild(b);
  });
  var total = 0, cur = 0;
  TOPICS.forEach(function(t){
    total += t.steps.length;
    if (st.done[t.id]) cur += t.steps.length;
    else if (st.t === t) cur += st.s;
  });
  document.getElementById('pg').style.width = (cur / total * 100) + '%';
  document.getElementById('sc1').textContent = st.solo;
  document.getElementById('sc2').textContent = st.helped;
}
function renderNote(){
  var n = document.getElementById('note');
  var items = TOPICS.filter(function(t){ return st.done[t.id]; });
  if (!items.length) {
    n.innerHTML = '<span class="empty">스스로 발견한 공식이 여기에 쌓여요.</span>';
    return;
  }
  n.innerHTML = '';
  items.forEach(function(t){
    var d = document.createElement('div');
    d.textContent = t.formula;
    n.appendChild(d);
  });
}

function startTopic(t){
  clearChoices();
  st.t = t; st.s = 0; st.tries = 0;
  renderTopics();
  addMsg('[' + t.name + '] 탐구 시작', 'user');
  bot(t.intro, '', null, ask);
}
function ask(){
  var step = st.t.steps[st.s];
  st.tries = 0;
  renderTopics();
  bot(step.q, '', step.svg, function(){
    if (step.type === 'choice') showChoices(step.choices);
    inp.focus();
  });
}

// ---------- 답 판단 ----------
function norm(s){ return s.replace(/\s+/g, '').toLowerCase(); }
function isHalf(s){
  var x = s.replace(/반지름/g, '');
  return /절반|반|2분의1|이분의일|1\/2|½|나누기2|÷2|\/2|0\.5|둘로나|2로나/.test(x);
}
function hasTok(s, tok){ return tok === 'HALF' ? isHalf(s) : s.indexOf(tok) >= 0; }
function check(step, raw){
  var s = norm(raw);
  if (step.type === 'num') {
    var m = s.replace(/,/g, '').match(/-?\d+(\.\d+)?/);
    return m ? Math.abs(parseFloat(m[0]) - step.ans) < 0.001 : false;
  }
  if (step.type === 'choice') return norm(step.ans) === s || s.indexOf(norm(step.ans)) >= 0;
  if (step.type === 'kw') {
    return step.kw.some(function(group){
      return group.every(function(tok){ return hasTok(s, tok); });
    });
  }
  return s.length > 0;
}

function next(){
  st.s++;
  if (st.s >= st.t.steps.length) {
    st.done[st.t.id] = true;
    renderTopics();
    renderNote();
    var remain = TOPICS.filter(function(t){ return !st.done[t.id]; });
    var msg = '[' + st.t.name + '] 탐구 완료!\n\n오늘 스스로 발견한 공식:\n' + st.t.formula + '\n\n공식을 외우는 것보다 "왜 그렇게 되는지"를 설명할 수 있는 것이 더 중요해요. 여러분은 이제 설명할 수 있어요.';
    if (remain.length) msg += '\n\n다음엔 어떤 도형을 탐구해 볼까요?';
    else msg += '\n\n모든 도형을 탐구했어요! 모든 공식이 결국 "직사각형으로 바꾸기"에서 나왔다는 것, 눈치챘나요?';
    bot(msg, 'good', null, function(){
      if (remain.length) showChoices(remain.map(function(t){ return t.name; }));
    });
    st.t = null;
    return;
  }
  ask();
}

function userSay(text){
  text = (text || '').trim();
  if (!text || st.lock) return;
  clearChoices();
  addMsg(text, 'user');
  inp.value = '';

  if (!st.t) {
    var tp = TOPICS.find(function(t){ return norm(t.name).indexOf(norm(text)) >= 0 || norm(text).indexOf(norm(t.name).replace(/\(.*\)/, '')) >= 0; });
    if (tp) { st.t = tp; st.s = 0; renderTopics(); bot(tp.intro, '', null, ask); }
    else bot('어떤 도형을 탐구해 볼까요? 왼쪽 목록이나 아래 버튼에서 골라 주세요.', '', null, function(){ showChoices(TOPICS.map(function(t){ return t.name; })); });
    return;
  }
  if (/처음부터|다시시작/.test(norm(text))) { var t0 = st.t; st.t = null; startTopic(t0); return; }

  var step = st.t.steps[st.s];
  var askHelp = /모르|몰라|힌트|글쎄|잘모|어려워|헷갈/.test(norm(text));

  if (!askHelp && check(step, text)) {
    if (step.type === 'open') { bot(step.ok, 'good', null, next); return; }
    if (st.tries === 0) st.solo++; else st.helped++;
    bot(pick(PRAISE) + ' ' + step.ok, 'good', null, next);
    return;
  }
  if (step.type === 'open') { bot('어떤 생각이든 좋아요. 짧게라도 내 생각을 적어 볼래요?', 'hint'); return; }

  st.tries++;
  var h = step.hints || [];
  if (st.tries <= h.length) {
    var pre = askHelp ? '괜찮아요, 모르는 건 부끄러운 게 아니에요. 이렇게 생각해 볼까요?' : pick(RETRY);
    bot(pre + '\n\n' + h[st.tries - 1], 'hint', null, function(){ if (step.type === 'choice') showChoices(step.choices); });
  } else {
    bot('함께 정리해 볼게요. 답은 "' + step.ans + '"이에요.\n' + step.ok + '\n\n왜 그런지 이해되었다면 다음으로 넘어가 볼게요.', '', null, next);
  }
}

document.getElementById('send').onclick = function(){ userSay(inp.value); };
inp.addEventListener('keydown', function(e){ if (e.key === 'Enter' && !e.isComposing) userSay(inp.value); });

renderTopics();
bot('안녕하세요! 저는 소크라테스 수학 선생님이에요.\n\n소크라테스는 답을 가르쳐 주는 대신 질문을 던져서 사람들이 스스로 깨닫게 했대요. 저도 질문을 할 테니, 여러분이 직접 도형의 넓이 공식을 "발견"해 보세요.\n\n어떤 도형부터 탐구해 볼까요? (처음이라면 평행사변형부터 추천해요)', '', null, function(){
  showChoices(TOPICS.map(function(t){ return t.name; }));
});
</script>
