// ---------- 문답 시나리오 ----------
// type: num(수) / kw(낱말) / choice(선택) / open(자유 생각)
// kw: 여러 묶음 중 하나라도 묶음 안의 낱말을 모두 포함하면 정답. 'HALF'는 반/절반/÷2 등
var TOPICS = [
 {id:'para', name:'평행사변형', formula:'평행사변형 = 밑변 × 높이',
  intro:'평행사변형의 넓이를 함께 탐구해 볼까요? 저는 답을 바로 알려주지 않고 질문을 할 거예요. 천천히 생각해 보세요.',
  steps:[
   {q:'먼저 이미 아는 것부터 떠올려 봐요. 가로 5cm, 세로 3cm인 직사각형의 넓이는 몇 cm²일까요?', type:'num', ans:15,
    hints:['넓이가 1cm²인 작은 정사각형이 몇 개 들어갈지 생각해 볼래요?','한 줄에 5개씩 놓이는데, 그런 줄이 3줄 있다면 모두 몇 개일까요?'],
    ok:'맞아요, 5 × 3 = 15cm²예요. 직사각형은 "가로 × 세로"였지요.'},
   {q:'이번엔 평행사변형을 봐요. 이 도형에도 1cm² 정사각형을 빈틈없이 놓기는 어려워 보여요. 그렇다면 우리가 넓이를 잘 아는 도형으로 바꿀 수는 없을까요?\n\n노란 삼각형을 잘라 오른쪽에 붙이면 어떤 도형이 될까요?', svg:'paraCut', type:'kw', ans:'직사각형',
    kw:[['직사각형'],['네모'],['사각형']],
    hints:['잘라 붙인 뒤 네 모서리의 각은 어떻게 될까요? 모두 직각이 되지 않나요?','네 각이 모두 직각인 사각형을 무엇이라고 불렀지요?'],
    ok:'그래요, 직사각형이 돼요. 그럼 넓이는 달라졌을까요? 잘라서 옮기기만 했으니 넓이는 그대로예요.'},
   {q:'새로 생긴 직사각형의 "가로"는 원래 평행사변형의 어느 부분과 같은 길이일까요?', svg:'para', type:'kw', ans:'밑변',
